{
  "run_name": "vi_data_001",
  "num_samples": 10,
  "language": "vietnamese",
  "minimum_per_label": 1,
  "batch_size": 5,
  "focus_label": "PERSON",
  "robin_labels": [
    "PHONE",
    "EMAIL",
    "ADDRESS",
    "DATE",
    "TIME",
    "MONEY",
    "URL",
    "IP",
    "CARD_NUMBER",
    "PLATE",
    "PASSPORT",
    "MEDICAL_INFO",
    "LOCATION"
