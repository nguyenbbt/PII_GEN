    "max_per_sample": 7
  },
  "sample_length_distribution": {
    "short": 0.2,
    "medium": 0.5,
    "long": 0.3
  },
  "difficulty_distribution": {
    "easy": 0,
    "medium": 0,
    "hard": 1
  },
  "sample_type_distribution": {
    "positive": 0.5,
    "pure_negative": 0.0,
    "hard_negative": 0.5
  },
  "sample_structure": {
    "type": "contract",
