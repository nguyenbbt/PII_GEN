{
  "run_name": "vi_data_001",
  "num_samples": 100,
  "language": "vietnamese",
  "minimum_per_label": 1,
  "batch_size": 5,
  "focus_label": "PERSON",
  "robin_labels": [
    "PHONE",
    "EMAIL",
    "ADDRESS",
    "DATE",
    "TIME",
    "MONEY",
    "URL",
    "IP",
    "CARD_NUMBER",
    "PLATE",
    "PASSPORT",
    "MEDICAL_INFO",
    "LOCATION"
  ],
  "robin_selection": {
    "min_per_sample": 4,
    "max_per_sample": 7
  },
  "sample_length_distribution": {
    "short": 0.2,
    "medium": 0.5,
    "long": 0.3
  },
  "difficulty_distribution": {
    "easy": 0,
    "medium": 0,
    "hard": 1
  },
  "sample_type_distribution": {
    "positive": 0.5,
    "pure_negative": 0.0,
    "hard_negative": 0.5
  },
  "sample_structures": [
    {
      "type": "contract"
    },
    {
      "type": "chat"
    },
    {
      "type": "custom",
      "custom_instruction": "Viết dưới dạng email nghiệp vụ tự nhiên."
    },
    {
      "type": "custom",
      "custom_instruction": "Viết dưới dạng phiếu yêu cầu hoặc ticket hỗ trợ."
    },
    {
      "type": "custom",
      "custom_instruction": "Viết dưới dạng báo cáo sự việc hoặc nhật ký vận hành."
    },
    {
      "type": "custom",
      "custom_instruction": "Viết dưới dạng ghi chú hoặc tin nhắn nội bộ tự nhiên."
    }
  ],
  "optional_constraint_distribution": {
    "teen_code": 0.0,
    "light_typo": 0.05,
    "abbreviation": 0.1
  },
  "max_entities": {
    "easy": 5,
    "medium": 6,
    "hard": 8
  },
  "max_regenerate_attempts": 2,
  "max_task_replacements": 2,
  "value_bank": {
    "path": "PII_Value_Bank",
    "language_files": {
      "vi": "vi_pii_value_pools.json",
      "en": "en_pii_value_pools.json",
      "de": "de_pii_value_pools.json"
    },
    "max_seed_pack_attempts": 5,
    "allow_additional_unseeded_pii": true
  },
  "hard_negative": {
    "mode": "mixed_contrastive",
    "min_decoys": 1,
    "max_decoys": 1,
    "max_focus_labels": 8,
    "unsupported_label_policy": "rebuild_task"
  },
  "complexity_limits": {
    "positive": 8,
    "pure_negative": 1,
    "hard_negative": 10
  },
  "validation": {
    "quality_checks_enabled": false,
    "accept_last_candidate_on_exhaustion": false
  },
  "verifier": {
    "enabled": true,
    "max_repairs_per_candidate": 1
  },
  "parallel_generation": {
    "workers": 10,
    "shard_size": 10,
    "max_shard_retries": 2
  },
  "random_seed": 174
}
