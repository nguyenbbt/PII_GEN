# Azure OpenAI connection. Copy this file to .env and fill in the secret locally.
OPENAI_API_KEY=
BASE_URL=https://your-resource.openai.azure.com
OPENAI_API_STYLE=auto
API_VERSION=2024-08-01-preview
MODEL=gemini-2.5-flash
GENERATOR_MODEL=gemini-2.5-flash
VERIFIER_MODEL=gemini-2.5-pro
DEPLOYMENT_NAME=gpt-4o
TEMPERATURE=0.2
MAX_TOKENS=6000
LLM_TIMEOUT_SECONDS=120
LLM_INFRA_MAX_RETRIES=3
VERIFIER_TEMPERATURE=0.0
VERIFIER_JUDGE_MAX_TOKENS=4000
VERIFIER_REPAIR_MAX_TOKENS=2500
GEN_DATA_DIR=gen_data
PII_TAXONOMY_PATH=pii_taxonomy_rules.json
# Optional: path to a trusted CA bundle for Python distributions without system roots.
# SSL_CERT_FILE=/path/to/ca-bundle.crt

# This OpenAI-compatible gateway returns token usage, not a USD cost field.
# Prices are USD per 1,000,000 tokens and must match your provider contract.
# Role-specific values are preferred because Generator and Verifier use
# different models. Generic values remain compatibility fallbacks.
INPUT_TOKEN_PRICE_PER_MILLION_USD=0.30
OUTPUT_TOKEN_PRICE_PER_MILLION_USD=2.50
GENERATOR_INPUT_TOKEN_PRICE_PER_MILLION_USD=0.30
GENERATOR_OUTPUT_TOKEN_PRICE_PER_MILLION_USD=2.50
VERIFIER_INPUT_TOKEN_PRICE_PER_MILLION_USD=1.25
VERIFIER_OUTPUT_TOKEN_PRICE_PER_MILLION_USD=10.00

# Gemini/OpenAI-compatible responses can report reasoning tokens inside
# total_tokens without adding them to completion_tokens. The runtime bills
# output as max(completion_tokens, total_tokens - prompt_tokens).
